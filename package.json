{
  "name": "steward-frontend",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/ra-steward",
    "demo"
  ],
  "scripts": {
    "dev": "npm run dev -w demo",
    "build": "npm run build:library && npm run build -w demo",
    "build:library": "npm run build -w ra-steward",
    "typecheck": "tsc -p packages/ra-steward && tsc -p demo && tsc -p e2e",
    "test": "vitest run",
    "test:release": "node --test scripts/release.test.mjs scripts/publication.test.mjs",
    "test:package": "node scripts/test-package.mjs",
    "pack": "npm pack -w ra-steward --pack-destination artifacts",
    "release:check": "node scripts/release.mjs",
    "release:publish": "node scripts/publish.mjs",
    "e2e": "playwright test",
    "icons": "bash scripts/gen-icons.sh"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
